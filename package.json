{
  "name": "translatte",
  "productName": "TransLatte",
  "version": "0.1.1",
  "description": "Lokální překladač PDF a dokumentů přes LM Studio",
  "author": "olda",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/icons.mjs"
  },
  "build": {
    "appId": "eu.hollmotz.translatte",
    "productName": "TransLatte",
    "artifactName": "TransLatte-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "asarUnpack": [
      "dist/spell-worker.js"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon-win.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "draft"
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "npmRebuild": false
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/node": "^26.6.5",
    "docx": "^9.13.0",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "mammoth": "^1.13.0",
    "nspell": "2.1.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "sharp": "^0.35.5",
    "tinyld": "^1.3.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "hyphen": "1.14.1"
  }
}
